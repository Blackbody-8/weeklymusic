# Copy this file to secrets_config.py and fill in your real values.
# secrets_config.py is listed in .gitignore — it never gets committed or
# pushed to GitHub. It only needs to exist on your PythonAnywhere account.

GEMINI_API_KEY = "your-gemini-api-key-here"

# A GitHub personal access token with "Contents: read and write" permission
# on the one repo below (a fine-grained token scoped to just this repo is best).
GITHUB_TOKEN = "your-github-token-here"

# "your-username/your-repo-name"
GITHUB_REPO = "yourusername/weekly-music-drop"

# The branch GitHub Pages is set to publish from — usually "main".
GITHUB_BRANCH = "main"
